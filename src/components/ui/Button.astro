---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'button'> {
  href?: string;
  inverted?: boolean;
}

const {
  class: className,
  href,
  inverted = false,
  type = 'button',
  ...attributes
} = Astro.props;

const classes = ['button', { 'button--inverted': inverted }, className];
---

{
  href ? (
    <a {...attributes} class:list={classes} href={href}>
      <slot />
    </a>
  ) : (
    <button {...attributes} class:list={classes} type={type}>
      <slot />
    </button>
  )
}
