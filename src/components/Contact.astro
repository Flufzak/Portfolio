---
import { t } from '../i18n';
---

<section id="contact" class="pb-13 flex flex-col text-center">
  <h2 class="mb-10 sm:mb-10" data-i18n="contact-title">
    {t('contact-title')}
  </h2>

  <p data-i18n="contact-body">{t('contact-body')}</p>

  <a
    class="linkedin-link text-(--primary) hover:underline"
    href="https://www.linkedin.com/in/suzanna-khachatryan-06b508362"
    target="_blank"
    rel="noopener noreferrer"
  >
    <img src="/assets/LinkedIn.svg" alt="LinkedIn" width="20" height="20" />
    <span data-i18n="contact-me">{t('contact-me')}</span></a
  >
</section>
